# ========================================================
# IN THE OUTER // ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# Server Port (Node.js Express + WebSocket Server)
PORT=3000

# Public URL of the frontend deployment (e.g. https://in-the-outer.vercel.app)
# Used for CORS whitelist and Big Screen QR code controller URL generation
FRONTEND_URL=

# Public WebSocket URL for clients (Vite build-time variable)
# Format: wss://in-the-outer-backend.onrender.com/ws
VITE_WS_URL=

# Public Frontend URL for clients (Vite build-time variable)
# Used by Big Screen to generate room join links & QR codes
# Format: https://in-the-outer.vercel.app
VITE_FRONTEND_URL=

# Node Environment ('production' or 'development')
NODE_ENV=development
